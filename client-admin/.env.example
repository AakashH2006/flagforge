# Where the API lives. Leave empty in development: Vite proxies /api to http://localhost:4000.
# For a deployed build on a different origin, set the API origin, e.g. https://api.example.com
# (and add this client's origin to CORS_ORIGINS on the server).
VITE_API_URL=

# Where the player client is served. The dashboard links to its public scoreboard page.
VITE_PARTICIPANT_URL=http://localhost:5174
