NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://ctf:ctf@localhost:5433/ctf
REDIS_URL=redis://localhost:6379/0

# Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-jwt-secret-change-me-0000000000
JWT_EXPIRES_IN=12h

# The key for the flag HMACs. If you change it, every stored flag stops matching
# and all challenge flags must be set again.
FLAG_SECRET=dev-only-flag-secret-change-me-000000000

# Browser origins allowed to call the API (the admin and participant clients).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Where challenge attachments are written. Point this at a mounted volume in production:
# the files are not in the database, so they do not come back with it.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
MAX_ATTACHMENTS_PER_CHALLENGE=10

# Set to true when running behind a reverse proxy, so req.ip is the client's IP.
TRUST_PROXY=false

# Flag submissions allowed per user in each window.
FLAG_RATE_LIMIT_MAX=10
FLAG_RATE_LIMIT_WINDOW_SECONDS=60

# Login/register attempts allowed per IP in each window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Passwords used by `npm run db:seed` for the demo accounts.
SEED_ADMIN_PASSWORD=admin-demo-pass
SEED_PLAYER_PASSWORD=player-demo-pass
