# Secrets for docker-compose.prod.yml. Copy to .env.prod and fill in real values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

POSTGRES_PASSWORD=
JWT_SECRET=
# Changing this invalidates every stored flag. Set it once, before the first challenge.
FLAG_SECRET=

# Where the two clients are reachable. The API only accepts browser requests from these origins,
# and the dashboard links to the player site's public scoreboard.
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
PARTICIPANT_URL=http://localhost:8080
